# ==========================================
# Portfolio SMTP Mailer Configuration
# ==========================================
# Copy this file to .env and fill in your actual SMTP credentials.
# If .env is not present, default fallback values from config.php will be used.

# SMTP Server details (e.g., smtp.gmail.com, smtp.zoho.com, smtp.mailtrap.io)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls # Options: tls, ssl, or none
SMTP_TIMEOUT=15

# SMTP Authentication credentials
SMTP_USER=your_email@gmail.com
# For Gmail, use an App Password (https://myaccount.google.com/apppasswords)
SMTP_PASS=your_app_password_here

# Sender & Recipient Information
MAIL_FROM_EMAIL=no-reply@yourdomain.com
MAIL_FROM_NAME=Akhil V V Portfolio
MAIL_TO_EMAIL=vvakhilkarun@gmail.com
